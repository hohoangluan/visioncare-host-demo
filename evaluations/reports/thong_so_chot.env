# Bộ thông số chốt AI — 2026-10-21 (nhánh chot-ai-2026-10-21). Xem reports/THONG_SO_CHOT.md.
# Chỉ ghi biến khác mặc định của code hoặc cần chỉ rõ. Đường dẫn tính từ SeeVia_system/ (model .onnx không nằm trong git).

# Vật cản — detector fine-tune (C1a: recall vật trong lối 37,3 % -> 89,9 %)
HAZARD_MODEL_PATH=evaluations/train/models/ft_11s_last_320.onnx
HAZARD_CLASSES_JSON=evaluations/train/classes_vh.json
HAZARD_MIN_SCORE=0.35
# Vật cản — logic: predict KHÔNG đạt luật chọn C1b (vòng 1 và vòng 2 đều selected = null) -> giữ logic cũ
HAZARD_LOGIC=area

# Đọc tiền v2 (mặc định code, ghi rõ)
MONEY_MODE=choice
MONEY_MIN_PROB=0.999
MONEY_RETRY=1
MONEY_RETRY_PROB=0.999
MONEY_MULTI_MIN_PROB=0.98

# OCR — cảnh báo chữ số không chắc
OCR_DIGIT_HEDGE_PROB=0.9
