+    task = asyncio.create_task(ocr_live.run(box.ws, box.session))
+
+    async def feed():
+        for wait, jpeg in script:
+            await asyncio.sleep(wait)
+            box.ws.feed_frame(jpeg)
+
+    await asyncio.gather(task, feed())
