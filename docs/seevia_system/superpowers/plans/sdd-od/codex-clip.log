"""Làn C (predict): ước lượng khoảng cách và lệch ngang của vật từ MỘT hộp QVGA, camera đơn, không IMU.

Hai nguồn độc lập, gộp theo nghịch đảo phương sai khi cả hai hợp lệ:
- height: Z = f·H/h_px với H = chiều cao điển hình của lớp (sai số tương đối theo lớp);
- ground: đáy hộp chạm mặt đất, Z = cam_h·f / (y_đáy − cy + f·tan(cúi)) — không cần biết lớp.
Hộp chạm mép ảnh thì nguồn đó mất tin cậy. Đáy chạm mép dưới (camera cao 1,6 m chỉ thấy đất từ ~3,3 m) thì KHÔNG có
Z từ một khung: `estimate` trả source="clipped", z_m=NaN; TrackSet lấy Z = Z_track_trước · w_trước / w_nay (bề rộng
không bị mép dưới cắt), track mới thì dùng `z_width` từ bảng bề rộng lớp.

Toạ độ: X ngang (dương = bên phải), Z phía trước, mét, gốc là camera.
"""

import math
from dataclasses import dataclass
from functools import cached_property

import config
from live import hazard

# Chiều cao điển hình (m) của từng `kind` (COCO của hazard._CLASSES + evaluations/train/classes_vh.json).
CLASS_HEIGHT_M: dict[str, float] = {
    "person": 1.65,               # người lớn Việt Nam đứng
    "dog": 0.5,                   # chó cỡ trung, tới vai
    "bicycle": 1.1,               # xe đạp có người ngồi nhìn từ sau/trước: tới đầu
    "motorbike": 1.2,             # xe máy tính cả người ngồi (đa số ảnh có người lái)
    "tricycle": 1.3,              # xe ba bánh/xích lô: mái che thấp
    "car": 1.5,                   # sedan/SUV nhỏ, bỏ qua xe cao
    "bus": 3.0,                   # xe buýt/khách
    "truck": 3.0,                 # xe tải
    "pole": 1.0,                  # cột bị khung cắt thường xuyên -> chiều cao không đáng tin (σ lớn)
    "warning_column": 1.0,        # trụ cảnh báo, cao 0,6-1,2 m tuỳ loại (σ lớn)
    "reflective_cone": 0.7,       # cọc tiêu giao thông chuẩn 70 cm
    "spherical_roadblock": 0.6,   # bi chặn xe hình cầu trước vỉa hè
    "ashcan": 0.9,                # thùng rác công cộng
    "bench": 0.45,                # ghế đá: tính mặt ghế (lưng ghế bị che/cắt)
    "chair": 0.85,                # ghế có lưng
    "plant": 0.8,                 # chậu cây ven đường (σ lớn: kích thước rất khác nhau)
    "hydrant": 0.7,               # trụ cứu hoả (nhãn COCO)
    "fire_hydrant": 0.7,          # trụ cứu hoả (nhãn classes_vh)
    "stop_sign": 2.2,             # biển báo treo trên cột: tính tới đỉnh biển
    "traffic_light": 3.0,         # đèn giao thông trên trụ
    "parking_meter": 1.2,         # cột thu phí đỗ xe
}

# Lớp KHÔNG có chiều cao điển hình (cột phố cao ~1-8 m): không cho Z theo chiều cao, chỉ mặt đất + tỉ lệ bề rộng.
NO_HEIGHT_KINDS = frozenset({"pole", "warning_column", "traffic_light", "stop_sign", "plant", "parking_meter"})

# Bề rộng điển hình (m) của từng `kind`, chỉ để định Z cho track MỚI có đáy hộp bị cắt (σ = 0,4·Z).
CLASS_WIDTH_M: dict[str, float] = {
    "person": 0.5,                # vai người lớn nhìn thẳng
    "dog": 0.35,                  # chó cỡ trung nhìn trước/sau
    "bicycle": 0.6,               # xe đạp nhìn trước/sau: tay lái + người
    "motorbike": 0.8,             # xe máy nhìn trước/sau tính cả người ngồi
    "tricycle": 1.1,              # xe ba bánh/xích lô
    "car": 1.8,                   # thân xe con
    "bus": 2.5,                   # xe buýt/khách
    "truck": 2.4,                 # xe tải
    "pole": 0.15,                 # cột đèn/cột điện đường kính ~15 cm
    "warning_column": 0.2,        # trụ cảnh báo
    "reflective_cone": 0.3,       # đế cọc tiêu
    "spherical_roadblock": 0.5,   # bi chặn đường kính ~50 cm
    "ashcan": 0.5,                # thùng rác công cộng
    "bench": 1.5,                 # ghế đá dài
    "chair": 0.5,                 # ghế có lưng
    "plant": 0.6,                 # chậu cây
    "hydrant": 0.3,               # trụ cứu hoả (nhãn COCO)
    "fire_hydrant": 0.3,          # trụ cứu hoả (nhãn classes_vh)
    "stop_sign": 0.75,            # biển báo tròn/bát giác
    "traffic_light": 0.4,         # hộp đèn giao thông
    "parking_meter": 0.25,        # cột thu phí đỗ xe
}
_UNKNOWN_W = 0.5      # lớp ngoài bảng bề rộng

# Sai số tương đối của chiều cao lớp. Mặc định 0,15; cột/cây/biển có kích thước rất khác nhau nên 0,5.
CLASS_HEIGHT_REL_SIGMA: dict[str, float] = {
    "pole": 0.5, "warning_column": 0.5, "plant": 0.5, "stop_sign": 0.5, "traffic_light": 0.5,
}
_REL_SIGMA_DEFAULT = 0.15
_EDGE = 0.01          # cạnh hộp cách mép ảnh <= mức này (tỉ lệ) coi như bị cắt
_WIDTH_REL = 0.4     # σ_Z của Z theo bề rộng danh nghĩa
_PITCH_MIN_Z = 3.0    # mẫu góc cúi chỉ lấy khi Z theo chiều cao >= mức này (gần quá thì sai số lớp phóng đại)
_GROUND_REL = 0.03    # σ_Z = Z²·0,03/cam_h (≈ ±4 px sai số đáy hộp ở QVGA)
_GROUND_MIN_PX = 2.0  # đáy phải nằm dưới đường chân trời ít nhất ngần này px
_Z_MAX = 60.0
_LAT_VAR = 4.0        # hộp chạm mép bên: phương sai X ×4 (cạnh trong + bề rộng lớp kém tin hơn tâm)
_LAT_VAR_BOTH = 25.0  # cắt cả hai bên: vật choán hết bề ngang, X = 0 với phương sai rất lớn
_UNKNOWN_H = 1.0      # lớp ngoài bảng: chỉ dùng khi phải rơi về nguồn width


@dataclass(frozen=True)
class Camera:
    """Camera danh nghĩa: ảnh w×h, góc nhìn ngang, độ cao so với mặt đất."""

    w: int
    h: int
    hfov_deg: float
    height_m: float

    @cached_property  # gọi mỗi detection mỗi khung: tính một lần
    def f_px(self) -> float:
        return (self.w / 2) / math.tan(math.radians(self.hfov_deg / 2))

    @staticmethod
    def default() -> "Camera":
        return Camera(320, 240, config.HAZARD_CAM_HFOV_DEG, config.HAZARD_CAM_HEIGHT_M)


@dataclass
class Estimate:
    z_m: float
    x_m: float
    z_sigma: float
    source: str  # "height" | "ground" | "fused" | "width" | "clipped"
    # "clipped" (đáy hộp chạm mép dưới): z_m = x_m = z_sigma = NaN, "Z cần track". `bearing` = X/Z (tan góc ngang),
    # `z_width` = Z theo bề rộng danh nghĩa của lớp (dùng khi track mới, σ = 0,4·Z).
    bearing: float = 0.0
    z_width: float = math.nan
    # Hộp chạm mép trái/phải: tâm hộp sai (vật bị cắt). X lấy từ CẠNH TRONG: X = lat_bearing·Z + lat_off_m
    # (lat_off_m = ∓ nửa bề rộng lớp); phương sai X nhân x_var_scale. lat_bearing = NaN: hộp không bị cắt ngang.
    lat_bearing: float = math.nan
    lat_off_m: float = 0.0
    x_var_scale: float = 1.0


def _height_z(det: hazard.Detection, cam: Camera, h_px: float) -> tuple[float, float] | None:
    """(Z, σ) theo chiều cao lớp; None nếu lớp lạ hoặc hộp bị cắt trên/dưới."""
    H = CLASS_HEIGHT_M.get(det.kind)
    if H is None or det.kind in NO_HEIGHT_KINDS or det.box[1] <= _EDGE or det.box[3] >= 1 - _EDGE or h_px <= 1.0:
        return None
    z = cam.f_px * H / h_px
    return z, CLASS_HEIGHT_REL_SIGMA.get(det.kind, _REL_SIGMA_DEFAULT) * z


def _ground_z(cam: Camera, y_bot: float, pitch_rad: float) -> tuple[float, float] | None:
    """(Z, σ) theo đáy hộp chạm đất; None nếu đáy chạm mép dưới hoặc chưa dưới đường chân trời."""
    if y_bot >= cam.h * (1 - _EDGE):
        return None
    d = y_bot - cam.h / 2 + cam.f_px * math.tan(pitch_rad)
    if d < _GROUND_MIN_PX:
        return None
    z = min(cam.height_m * cam.f_px / d, _Z_MAX)
    return z, z * z * _GROUND_REL / cam.height_m


def _lateral(det: hazard.Detection, cam: Camera) -> tuple[float, float, float]:
    """(lat_bearing, lat_off_m, x_var_scale) theo cạnh trong khi hộp chạm mép trái/phải; NaN nếu không chạm."""
    x0, _, x1, _ = det.box
    left, right = x0 <= _EDGE, x1 >= 1 - _EDGE
    half = CLASS_WIDTH_M.get(det.kind, _UNKNOWN_W) / 2
    if left and right:
        return 0.0, 0.0, _LAT_VAR_BOTH
    if right:  # thấy cạnh trái của vật; tâm = cạnh trái + nửa bề rộng (ra phía ngoài = bên phải)
        return (x0 * cam.w - cam.w / 2) / cam.f_px, half, _LAT_VAR
    if left:
        return (x1 * cam.w - cam.w / 2) / cam.f_px, -half, _LAT_VAR
    return math.nan, 0.0, 1.0


def estimate(det: hazard.Detection, cam: Camera, pitch_rad: float = 0.0) -> Estimate:
    """Hộp -> (Z, X, σ_Z). `pitch_rad` > 0 = ảnh trượt lên (camera ngẩng); chỉ nguồn ground phụ thuộc nó."""
    x0, y0, x1, y1 = det.box
    y_top, y_bot = y0 * cam.h, y1 * cam.h
    cx_px = (x0 + x1) / 2 * cam.w
    height = _height_z(det, cam, y_bot - y_top)
    ground = _ground_z(cam, y_bot, pitch_rad)
    if height and ground:
        wh, wg = 1 / height[1] ** 2, 1 / ground[1] ** 2
        z, sigma, source = (height[0] * wh + ground[0] * wg) / (wh + wg), (wh + wg) ** -0.5, "fused"
    elif height:
        (z, sigma), source = height, "height"
    elif ground:
        (z, sigma), source = ground, "ground"
    elif y_bot >= cam.h * (1 - _EDGE):
        w_px = max((x1 - x0) * cam.w, 1.0)
        zw = min(cam.f_px * CLASS_WIDTH_M.get(det.kind, _UNKNOWN_W) / w_px, _Z_MAX)
        bearing = (cx_px - cam.w / 2) / cam.f_px
        lb, lo, lv = _lateral(det, cam)
        return Estimate(math.nan, math.nan, math.nan, "clipped", bearing, zw, lb, lo, lv)
    else:  # không nguồn nào hợp lệ (vd. đáy trên đường chân trời, lớp lạ): dùng bề rộng, rộng chuẩn = 0,5·H
        w_px = max((x1 - x0) * cam.w, 1.0)
        w_m = CLASS_WIDTH_M.get(det.kind, _UNKNOWN_W) if det.kind in NO_HEIGHT_KINDS else 0.5 * CLASS_HEIGHT_M.get(det.kind, _UNKNOWN_H)
        z = min(cam.f_px * w_m / w_px, _Z_MAX)
        sigma, source = z * _WIDTH_REL, "width"
    lb, lo, lv = _lateral(det, cam)
    x = (cx_px - cam.w / 2) * z / cam.f_px if math.isnan(lb) else lb * z + lo
    return Estimate(z, x, sigma, source, (cx_px - cam.w / 2) / cam.f_px, math.nan, lb, lo, lv)


def pitch_sample(det: hazard.Detection, cam: Camera) -> float | None:
    """Một mẫu góc cúi (rad) khi hộp có cả nguồn height lẫn ground: tìm góc làm hai Z khớp nhau.

    Z_height không phụ thuộc góc, nên tan(p) = cam_h/Z_h − (y_đáy − cy)/f. Chỉ lấy lớp có σ chiều cao nhỏ
    và Z_h đủ xa; còn lại None.
    """
    if CLASS_HEIGHT_REL_SIGMA.get(det.kind, _REL_SIGMA_DEFAULT) > _REL_SIGMA_DEFAULT:
        return None
    y_bot = det.box[3] * cam.h
    height = _height_z(det, cam, (det.box[3] - det.box[1]) * cam.h)
    if height is None or height[0] < _PITCH_MIN_Z or y_bot >= cam.h * (1 - _EDGE):
        return None
    return math.atan(cam.height_m / height[0] - (y_bot - cam.h / 2) / cam.f_px)
"""Làn C (predict): gán detection qua các khung thành track và lọc Kalman (X, Z, vX, vZ) theo mốc thời gian thật.

Vận tốc không đổi, nhiễu quá trình dạng gia tốc trắng. Đo (X, Z) có R chéo nên hai trục tách rời nhau:
mỗi trục là một bộ lọc 2 trạng thái (vị trí, vận tốc) tính bằng số thực thuần Python (nhanh hơn numpy cho
ma trận 2×2, phần ngân sách 1 ms/khung). `x` và `P` vẫn giữ dạng 4 / 4×4 theo thứ tự [X, Z, vX, vZ].
"""

from dataclasses import dataclass

import numpy as np

from live import hazard
from live.hazard_geom import Estimate

DT_DEFAULT = 0.125     # 8 fps; dùng khi mốc thời gian thiếu / trùng / lùi / nhảy quá xa
DT_MAX = 1.0
IOU_MIN = 0.2          # ngưỡng gán track <-> detection (hộp dự đoán = hộp cũ)
X_REL_SIGMA = 0.1      # σ_X đo = 0,1·Z (cùng góc ngang, Z càng xa X càng lệch)
_EDGE_X = 0.01        # hộp cách mép trái/phải <= mức này (tỉ lệ) = bị cắt ngang
V_SIGMA_NEW = 3.0      # m/s: vận tốc ban đầu của track mới chưa biết gì


@dataclass
class Track:
    id: int
    kind: str
    group: str
    box: tuple
    x: np.ndarray  # [X, Z, vX, vZ]
    P: np.ndarray  # 4x4
    hits: int = 1
    misses: int = 0
    age: int = 1
    anchor_z: float = float('nan')  # Z đo thô lần cuối KHÔNG bị cắt đáy (neo cho tỉ lệ bề rộng)
    anchor_w: float = float('nan')  # bề rộng hộp (tỉ lệ) lúc đó

    def predict_xz(self, t_ahead: float) -> tuple[float, float]:
        return float(self.x[0] + self.x[2] * t_ahead), float(self.x[1] + self.x[3] * t_ahead)

    def sigma_x(self) -> float:
        return float(max(self.P[0, 0], 0.0) ** 0.5)


def _axis(x: np.ndarray, P: np.ndarray, i: int, dt: float, q: float, meas: float | None, r: float) -> None:
    """Một trục (i=0: X/vX, i=1: Z/vZ): dự đoán dt giây rồi (nếu có đo) cập nhật. Ghi thẳng vào x, P."""
    j = i + 2
    p, v = float(x[i]), float(x[j])
    a, b, d = float(P[i, i]), float(P[i, j]), float(P[j, j])
    p += dt * v
    a, b, d = a + 2 * dt * b + dt * dt * d + q * dt ** 3 / 3, b + dt * d + q * dt * dt / 2, d + q * dt
    if meas is not None:
        s = a + r
        y = meas - p
        p, v = p + a / s * y, v + b / s * y
        a, b, d = a - a * a / s, b - a * b / s, d - b * b / s
    x[i], x[j] = p, v
    P[i, i], P[i, j], P[j, i], P[j, j] = a, b, b, d


class TrackSet:
    def __init__(self, coast: int, q: float) -> None:
        self.coast, self.q = coast, q
        self._tracks: list[Track] = []
        self._next_id = 1
        self._t_prev: float | None = None
        self.last_matched: list[Track | None] = []  # theo thứ tự detection của lần update gần nhất; None = không có track

    def reset(self) -> None:
        self._tracks, self._t_prev, self.last_matched = [], None, []

    def _dt(self, t: float | None) -> float:
        prev, self._t_prev = self._t_prev, t
        if t is None or prev is None or not (0.0 < t - prev <= DT_MAX):  # mốc trùng/lùi/None/nhảy: coi như 1 khung
            return DT_DEFAULT
        return t - prev

    def update(
        self, dets: list[hazard.Detection], ests: list[Estimate], t: float | None,
        ego_shift_rad: float = 0.0, box_shift_x: float = 0.0, r_scale: float = 1.0, allow_new: bool = True,
    ) -> list[Track]:
        """Cập nhật track bằng các detection của một khung, trả mọi track còn sống (đang thấy + đang coast).

        `ego_shift_rad`: góc cảnh trượt sang phải do quay đầu (dương = X đo của vật đứng yên tăng); mỗi track được
        dời X thêm Z·rad vào hệ camera mới trước khi dự đoán nên vận tốc ước lượng là của vật, không của đầu.
        `box_shift_x`: cùng độ trượt ấy theo tỉ lệ bề rộng ảnh, để gán IoU không rớt khi quay nhanh.
        `r_scale`: nhân R (ảnh nhoè thì đo kém tin). `allow_new=False`: không tạo track từ khung này.
        """
        dt = self._dt(t)
        tracks = old = self._tracks
        for tr in tracks:
            if ego_shift_rad:
                tr.x[0] += tr.x[1] * ego_shift_rad
        pairs = self._match(tracks, dets, box_shift_x)
        matched_det: set[int] = set()
        for ti, di in pairs:
            tr, det, est = tracks[ti], dets[di], ests[di]
            if est.source == "clipped":
                zm = self._width_ratio_z(tr, det)
                if zm is None:  # Z không quan sát được: chỉ dự đoán Z, X vẫn lấy từ góc ngang
                    _axis(tr.x, tr.P, 1, dt, self.q, None, 0.0)
                    zp = max(float(tr.x[1]), 0.3)
                    _axis(tr.x, tr.P, 0, dt, self.q, self._x_at(est, zp), (X_REL_SIGMA * zp) ** 2 * r_scale * est.x_var_scale)
                else:
                    _axis(tr.x, tr.P, 1, dt, self.q, zm, (0.1 * zm) ** 2 * r_scale)
                    _axis(tr.x, tr.P, 0, dt, self.q, self._x_at(est, zm), (X_REL_SIGMA * zm) ** 2 * r_scale * est.x_var_scale)
            else:
                z_sigma = max(est.z_sigma, 1e-3)
                _axis(tr.x, tr.P, 0, dt, self.q, est.x_m, (X_REL_SIGMA * est.z_m) ** 2 * r_scale * est.x_var_scale)
                _axis(tr.x, tr.P, 1, dt, self.q, est.z_m, z_sigma ** 2 * r_scale)
                self._set_anchor(tr, est.z_m, det.box)
            tr.box, tr.kind, tr.hits, tr.misses = det.box, det.kind, tr.hits + 1, 0
            matched_det.add(di)
        matched_tr = {ti for ti, _ in pairs}
        for ti, tr in enumerate(tracks):
            tr.age += 1
            if ti not in matched_tr:
                _axis(tr.x, tr.P, 0, dt, self.q, None, 0.0)
                _axis(tr.x, tr.P, 1, dt, self.q, None, 0.0)
                tr.misses += 1
        self._tracks = tracks = [tr for tr in tracks if tr.misses <= self.coast]
        by_det: list[Track | None] = [None] * len(dets)
        for ti, di in pairs:
            by_det[di] = old[ti]
        if allow_new:
            for di, (det, est) in enumerate(zip(dets, ests)):
                if di not in matched_det:
                    by_det[di] = self._new(det, est)
                    tracks.append(by_det[di])
        self.last_matched = by_det
        return list(tracks)

    @staticmethod
    def _x_at(est: Estimate, z: float) -> float:
        """X đo tại độ sâu z: theo cạnh trong nếu hộp bị cắt ngang, còn lại theo tâm hộp."""
        return est.bearing * z if est.lat_bearing != est.lat_bearing else est.lat_bearing * z + est.lat_off_m

    @staticmethod
    def _set_anchor(tr: Track, z: float, box: tuple) -> None:
        if box[0] > _EDGE_X and box[2] < 1 - _EDGE_X and box[2] - box[0] > 1e-4:
            tr.anchor_z, tr.anchor_w = z, box[2] - box[0]

    @staticmethod
    def _width_ratio_z(tr: Track, det: hazard.Detection) -> float | None:
        """Đáy hộp bị cắt: Z = Z_neo · w_neo / w_nay (bề rộng không bị mép dưới cắt). Neo = Z đo thô lần cuối chưa
        bị cắt (hoặc Z theo bảng bề rộng của track mới), KHÔNG phải Z đã lọc: Z lọc đang mang độ trễ vận tốc, dùng nó
        làm gốc thì phép đo tương đối tự nhắc lại sai số của chính bộ lọc và vật đã dừng vẫn bị kéo lại gần.
        None nếu hộp nay chạm mép trái/phải, chưa có neo, hoặc bề rộng suy biến."""
        n0, n1 = det.box[0], det.box[2]
        if not (tr.anchor_w > 0) or n0 <= _EDGE_X or n1 >= 1 - _EDGE_X or n1 - n0 <= 1e-4:
            return None
        return min(max(tr.anchor_z * tr.anchor_w / (n1 - n0), 0.3), 60.0)

    def _new(self, det: hazard.Detection, est: Estimate) -> Track:
        if est.source == "clipped":  # Z theo bề rộng danh nghĩa của lớp, σ = 0,4·Z
            z = est.z_width
            est = Estimate(z, self._x_at(est, z), 0.4 * z, "width", est.bearing, x_var_scale=est.x_var_scale)
        x = np.array([est.x_m, est.z_m, 0.0, 0.0])
        P = np.diag([(X_REL_SIGMA * est.z_m) ** 2, max(est.z_sigma, 1e-3) ** 2, V_SIGMA_NEW ** 2, V_SIGMA_NEW ** 2])
        tr = Track(self._next_id, det.kind, det.group, det.box, x, P)
        self._next_id += 1
        self._set_anchor(tr, est.z_m, det.box)
        return tr

    @staticmethod
    def _match(tracks: list[Track], dets: list[hazard.Detection], box_shift_x: float) -> list[tuple[int, int]]:
        """Gán tham lam theo IoU giảm dần, cùng nhóm, IoU >= IOU_MIN. -> [(chỉ số track, chỉ số detection)]."""
        if not tracks or not dets:
            return []
        tb = np.array([tr.box for tr in tracks], dtype=np.float64)
        db = np.array([d.box for d in dets], dtype=np.float64)
        if box_shift_x:
            tb[:, [0, 2]] += box_shift_x
        iw = np.minimum(tb[:, None, 2], db[None, :, 2]) - np.maximum(tb[:, None, 0], db[None, :, 0])
        ih = np.minimum(tb[:, None, 3], db[None, :, 3]) - np.maximum(tb[:, None, 1], db[None, :, 1])
        inter = np.clip(iw, 0, None) * np.clip(ih, 0, None)
        area_t = (tb[:, 2] - tb[:, 0]) * (tb[:, 3] - tb[:, 1])
        area_d = (db[:, 2] - db[:, 0]) * (db[:, 3] - db[:, 1])
        union = area_t[:, None] + area_d[None, :] - inter
        iou = np.where(union > 1e-12, inter / np.maximum(union, 1e-12), 0.0)
        rows, cols = np.nonzero(iou >= IOU_MIN)
        order = sorted(zip(iou[rows, cols].tolist(), rows.tolist(), cols.tolist()), reverse=True)
        pairs, used_t, used_d = [], set(), set()
        for _, i, j in order:
            if i in used_t or j in used_d or tracks[i].group != dets[j].group:
                continue
            used_t.add(i); used_d.add(j)
            pairs.append((i, j))
        return pairs
"""HAZARD_LOGIC=predict: hình học ước lượng khoảng cách, track Kalman, xếp mức theo TTE."""

import importlib
import json
import math
import os

import numpy as np
import pytest

import config
from live import hazard
from live.hazard import Detection
from live import hazard_geom
from live.hazard_geom import Camera, CLASS_HEIGHT_M

CLASSES_VH = "/workingspace_aiclub/WorkingSpace/Personal/vannk/SeeVia_system/evaluations/train/classes_vh.json"

CAM = Camera(320, 240, 66.0, 1.6)


def _proj(X, Z, H, W, cam=CAM, pitch=0.0, base=0.0):
    """Chiếu pin-hole giống `bench/hazard_scenarios.Camera.project` (hộp tỉ lệ, đã cắt biên).

    `base` = độ cao đáy vật so với mặt đất; `pitch` đúng quy ước của `hazard_geom` (dương = cảnh trượt lên).
    """
    f = cam.f_px
    x0 = cam.w / 2 + f * (X - W / 2) / Z
    x1 = cam.w / 2 + f * (X + W / 2) / Z
    y_bot = cam.h / 2 + f * ((cam.height_m - base) / Z - math.tan(pitch))
    y_top = cam.h / 2 + f * ((cam.height_m - base - H) / Z - math.tan(pitch))
    c = lambda v, hi: min(max(v, 0.0), hi)
    return (c(x0, cam.w) / cam.w, c(y_top, cam.h) / cam.h, c(x1, cam.w) / cam.w, c(y_bot, cam.h) / cam.h)


def _person(X, Z, pitch=0.0):
    return Detection("person", "person", 0.9, _proj(X, Z, 1.65, 0.5, pitch=pitch))


# ---- Task 1: hình học ----

# Z = 3 m không dùng được: cam cao 1,6 m, VFOV ~52° thì chân người ở Z < 3,3 m đã chạm mép dưới (xem test sau).
@pytest.mark.parametrize("Z", [4.0, 6.0, 10.0])
def test_estimate_height_source_recovers_distance(Z):
    e = hazard_geom.estimate(_person(0.3, Z), CAM)
    assert abs(e.z_m - Z) / Z < 0.05
    assert abs(e.x_m - 0.3) < 0.1


def test_estimate_bottom_clipped_is_near():
    e = hazard_geom.estimate(_person(0.0, 1.0), CAM)
    assert e.source == "clipped" and math.isnan(e.z_m) and e.z_width < 1.5  # Z cần track; z_width = Z theo bề rộng bảng
    assert e.source != "height"


def test_estimate_bottom_clipped_width_z_reasonable():
    for Z in (1.0, 2.0, 3.0):  # chân bị cắt: Z theo bề rộng bảng (người 0,5 m) phải sát Z thật
        e = hazard_geom.estimate(_person(0.0, Z), CAM)
        assert e.source == "clipped" and abs(e.z_width - Z) < 0.2


def test_estimate_unknown_kind_finite():
    det = Detection("xyz", "static", 0.5, _proj(0.0, 4.0, 1.0, 0.5))
    e = hazard_geom.estimate(det, CAM)
    assert math.isfinite(e.z_m) and abs(e.z_m - 4) < 1.0
    assert math.isfinite(e.z_sigma) and e.z_sigma > 0


def test_estimate_pitch_shifts_ground_only():
    ground = Detection("xyz", "static", 0.5, _proj(0.0, 4.0, 1.0, 0.5))  # lớp lạ: chỉ có nguồn ground
    a, b = hazard_geom.estimate(ground, CAM, 0.0), hazard_geom.estimate(ground, CAM, 0.03)
    assert a.source == b.source == "ground" and abs(a.z_m - b.z_m) > 0.05
    sign = Detection("person", "person", 0.9, _proj(0.0, 8.0, 1.65, 0.5, base=1.8))  # đáy trên đường chân trời (lớp có chiều cao)
    a, b = hazard_geom.estimate(sign, CAM, 0.0), hazard_geom.estimate(sign, CAM, 0.03)
    assert a.source == b.source == "height" and a.z_m == b.z_m


def test_classes_json_overrides_coco(monkeypatch):
    if not os.path.exists(CLASSES_VH):
        pytest.skip("không có classes_vh.json")
    try:
        monkeypatch.setattr(config, "HAZARD_CLASSES_JSON", CLASSES_VH)
        importlib.reload(hazard)
        assert hazard._CLASSES[11] == ("pole", "static")
        monkeypatch.setattr(config, "HAZARD_CLASSES_JSON", "")
        importlib.reload(hazard)
        assert hazard._CLASSES[0] == ("person", "person")
    finally:
        monkeypatch.undo()
        importlib.reload(hazard)


def test_class_table_covers_all_kinds():
    kinds = {k for k, _ in hazard._CLASSES.values()}
    if os.path.exists(CLASSES_VH):
        kinds |= {v[0] for v in json.load(open(CLASSES_VH)).values()}
    assert not kinds - set(CLASS_HEIGHT_M)
    assert set(hazard_geom.CLASS_HEIGHT_REL_SIGMA) <= set(CLASS_HEIGHT_M)


# ---- Task 2: track + Kalman ----

from live import hazard_track
from live.hazard_geom import Estimate

DT = 0.125


def _obs(X, Z):
    det = _person(X, Z)
    return det, hazard_geom.estimate(det, CAM)


def _step(ts, t, objs, **kw):
    pairs = [_obs(X, Z) for X, Z in objs]
    return ts.update([d for d, _ in pairs], [e for _, e in pairs], t, **kw)


def test_track_velocity_converges():
    ts = hazard_track.TrackSet(coast=3, q=1.0)
    for k in range(16):
        tracks = _step(ts, k * DT, [(0.0, 12.0 - 1.2 * k * DT)])
    assert len(tracks) == 1 and abs(tracks[0].x[3] + 1.2) < 0.3


def test_track_dt_nonpositive_safe():
    ts = hazard_track.TrackSet(coast=3, q=1.0)
    for t in (1.0, 1.0, 0.5, None, 0.5, 100.0):  # trùng, lùi, None, nhảy xa
        tracks = _step(ts, t, [(0.0, 8.0)])
        for tr in tracks:
            assert np.isfinite(tr.x).all() and np.isfinite(tr.P).all()
    assert len(tracks) == 1


def test_track_coast_then_drop():
    ts = hazard_track.TrackSet(coast=3, q=1.0)
    for k in range(5):
        tracks = _step(ts, k * DT, [(0.0, 12.0 - 2.0 * k * DT)])
    old_id = tracks[0].id
    assert abs(tracks[0].x[3]) > 0.5  # đã học được vận tốc
    for k in range(5, 9):
        tracks = _step(ts, k * DT, [])
        assert len(tracks) == (1 if k < 8 else 0)  # coast 3 khung rồi xoá ở khung mất thứ 4
    tracks = _step(ts, 9 * DT, [(0.0, 10.0)])
    assert len(tracks) == 1 and tracks[0].id != old_id
    assert abs(tracks[0].x[3]) < 1e-6 and tracks[0].hits == 1


def test_track_two_objects_keep_ids():
    ts = hazard_track.TrackSet(coast=3, q=1.0)
    ids = None
    for k in range(10):
        tracks = _step(ts, k * DT, [(-1.0, 12.0 - 1.2 * k * DT), (1.0, 12.0 - 1.2 * k * DT)])
        cur = {round(tr.x[0]): tr.id for tr in tracks}
        assert len(tracks) == 2
        ids = ids or cur
        assert cur == ids


def test_ego_shift_removed():
    def run(shift):
        ts = hazard_track.TrackSet(coast=3, q=1.0)
        det = Detection("person", "person", 0.9, (0.4, 0.2, 0.6, 0.8))
        for k in range(20):
            tr, = ts.update([det], [Estimate(5.0, 5 * 0.04 * k, 0.3, "height")], k * DT, ego_shift_rad=shift)
        return tr
    assert abs(run(0.04).x[2]) < 0.3
    assert abs(run(0.0).x[2]) > 1.0  # đối chứng âm: không bù thì vật đứng yên bị đọc thành đang trượt ngang


# ---- Task 3: xếp mức theo TTE, AntiAnnoy phiếu/hysteresis, ego ----

import time

import cv2

from lanes import nav_live
from live import ego_motion, hazard_predict


class _Clock:
    def __init__(self):
        self.t = 0.0

    def __call__(self):
        return self.t


def _tracker():
    return hazard_predict.PredictTracker(hazard_predict.PredictParams(), CAM)


def test_area_default_unchanged(monkeypatch):
    monkeypatch.setattr(config, "HAZARD_LOGIC", "area")
    assert type(hazard.make_tracker()) is hazard.HazardTracker
    assert hazard.make_anti().l3_vote == 1
    levels = [0, 1, 1, 2, 2, 2, 3, 2, 2, 0, 0, 3, 3, 1, 1, 2, 2, 0, 0, 1, 1]
    c_old, c_new = _Clock(), _Clock()
    old, new = hazard.AntiAnnoy(c_old), hazard.make_anti(c_new)
    got_old, got_new = [], []
    for lvl in levels:
        c_old.t = c_new.t = c_old.t + 0.9
        got_old.append(old.step(lvl))
        got_new.append(new.step(lvl))
    assert got_old == got_new and any(got_old)
    monkeypatch.setattr(config, "HAZARD_LOGIC", "predict")
    assert isinstance(hazard.make_tracker(), hazard_predict.PredictTracker) and hazard.make_anti().l3_vote == 2


def _walk(tracker, objs, closing, n=80, stop_z=1.5):
    """Người dùng đi `closing` m/s: Z mỗi vật giảm closing·t. objs = [(X0, Z0, vX)] -> [(Z thật, X thật, Hazard)]."""
    out = []
    for k in range(n):
        t = k * DT
        pos = [(x0 + vx * t, z0 - closing * t) for x0, z0, vx in objs]
        if min(z for _, z in pos) < stop_z:
            break
        out.append((pos, tracker.assess([_person(x, z) for x, z in pos], t)))
    return out


def test_predict_static_person_timely():
    run = _walk(_tracker(), [(0.0, 12.0, 0.0)], 1.2)
    first = next(pos[0][1] for pos, h in run if h.level >= 2)
    assert first >= 2 + 1.5 * 1.2  # bíp mức >= 2 sớm >= 1,5 s trước khi vào Z < 2


def test_predict_pass_by_no_level2():
    run = _walk(_tracker(), [(1.0, 14.0, 0.0)], 2.4, stop_z=1.6)
    assert len(run) > 30 and all(h.level < 2 for _, h in run)


def test_predict_crossing_dir_left():
    # người dùng đi 1,2 m/s, người kia đi ngang từ X = -3 sang phải 1,0 m/s: sẽ vào hành lang (X > -0,6) lúc Z ~ 3
    run = _walk(_tracker(), [(-3.0, 6.0, 1.0)], 1.2, stop_z=2.0)
    hits = [(pos[0], h) for pos, h in run if h.level >= 2]
    assert hits and hits[0][1].dir == "left" and hits[0][0][0] < -0.6  # báo khi còn ngoài hành lang, phía trái


def test_predict_new_near_urgent():
    h = _tracker().assess([_person(0.0, 2.5)], 0.0)
    assert h.level == 3 and h.urgent


def test_anti_l3_vote():
    a = hazard.AntiAnnoy(l3_vote=2)
    assert [a.step(3), a.step(0), a.step(0)] == [False, False, False]
    b = hazard.AntiAnnoy(l3_vote=2)
    assert [b.step(3), b.step(3)] == [False, True]
    c = hazard.AntiAnnoy(l3_vote=2)
    assert c.step(3, urgent=True) is True
    d = hazard.AntiAnnoy(l3_vote=2, bypass_vote=False)
    assert d.step(3, urgent=True) is False


def test_anti_down_hold():
    anti = hazard.AntiAnnoy(l3_vote=1, down_hold=2)
    assert anti.step(3) is True and anti.current == 3
    assert anti.step(2) is False and anti.current == 3  # 1 khung thấp hơn chưa hạ
    assert anti.step(3) is False and anti.current == 3  # trở lại 3: không gửi lại
    assert anti.step(2) is False and anti.step(2) is False and anti.current == 2  # giữ 2 khung -> hạ
    held = hazard.AntiAnnoy(down_hold=3)
    held.step(3); held.step(2); held.step(2)
    assert held.current == 3
    held.step(2)
    assert held.current == 2


def test_predict_crowded_frame_fast():
    tracker = _tracker()
    rng = np.random.default_rng(0)
    objs = [(float(rng.choice([-1, 1]) * rng.uniform(0.9, 1.5)), 10.0 + 1.0 * i) for i in range(20)]  # dãy xe đỗ 2 bên
    times, levels = [], []
    for k in range(200):  # người dùng đi 0,25 m/s dọc dãy xe: Z giảm dần, không xe nào vào |X| < 0,6
        dets = [Detection("motorbike", "vehicle", 0.9, _proj(x, z - 0.25 * k * DT, 1.2, 0.6)) for x, z in objs]
        t0 = time.perf_counter()
        h = tracker.assess(dets, k * DT)
        times.append(time.perf_counter() - t0)
        levels.append(h.level)
    # 2 ms vì máy dùng chung; ngân sách thật 1 ms do phép đo C1c + luật chọn của bench giữ
    assert float(np.percentile(times, 90)) < 2e-3
    assert max(levels) < 2


def test_ego_meter_shift_sign():
    rng = np.random.default_rng(1)
    img = cv2.GaussianBlur(rng.integers(0, 255, (240, 320, 3), dtype=np.uint8), (3, 3), 0)
    meter = ego_motion.EgoMeter()
    first = meter.measure(img)
    assert first.shift_x == 0.0
    ego = meter.measure(np.roll(img, 16, axis=1))
    assert abs(ego.shift_x - 0.05) < 0.01
    assert ego.blur > ego_motion.EgoMeter().measure(cv2.GaussianBlur(img, (0, 0), 15)).blur


def test_process_frame_passes_time():
    seen = []

    class Det:
        def detect(self, bgr):
            return []

    class Tracker:
        def assess(self, dets, t=None, ego=None):
            seen.append((t, ego))
            return hazard.Hazard(0)

    ok, jpg = cv2.imencode(".jpg", np.zeros((240, 320, 3), np.uint8))
    nav_live.process_frame(Det(), Tracker(), jpg.tobytes(), 12.5)
    nav_live.process_frame(Det(), Tracker(), jpg.tobytes(), 13.0, ego_motion.EgoMeter())
    assert seen[0] == (12.5, None) and seen[1][0] == 13.0 and isinstance(seen[1][1], ego_motion.Ego)


def test_predict_no_ghost_after_vanish_and_bad_clock():
    tr = _tracker()
    for k in range(10):
        tr.assess([_person(0.0, 9.0 - 1.2 * k * DT)], k * DT)
    levels = [tr.assess([], (10 + k) * DT).level for k in range(6)]
    assert levels[-1] == 0  # sau coast khung không còn track ma
    h = tr.assess([_person(0.0, 8.0)], 20 * DT)

