   177	
   178	    mode = d.ocr_mode if d.ocr_mode in ("summarize", "raw", "specialized") else "read"
   179	    if ctx.single_shot:  # không có WS để hướng dẫn căn khung: đọc thẳng ảnh đã có
   180	        return Reply(speech=_sync(ctx, ocr_live.spoken(entry.jpeg, mode, ctx.device)),
