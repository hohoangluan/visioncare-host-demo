   184	        problem, boxes = await task if task is not None else ("look_around", [])
   185	        logger.info("làn B: ảnh buffer %s (%d hộp chữ)", problem or "ĐẠT -> đọc ngay", len(boxes))
   186	        if problem is None:
   187	            return Reply(speech=_sync(ctx, ocr_live.spoken(entry.jpeg, mode, ctx.device)),
   188	                         intent="ocr", lane="B")
   189	    session = ctx.prewarmer.session("ocr", {"mode": mode, "fallback_jpeg": entry.jpeg})
   190	    return Reply(cues=["ocr_start"], live="ocr", live_token=session.token, intent="ocr", lane="B")
