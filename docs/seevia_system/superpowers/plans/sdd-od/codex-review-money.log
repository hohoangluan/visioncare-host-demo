   162	async def receive_frames(ws: WebSocket, box: _Mailbox, session: LiveSession) -> None:
   163	    min_gap = 1.0 / config.LIVE_MAX_FPS if config.LIVE_MAX_FPS > 0 else 0.0
   164	    last = 0.0
   165	    try:
   166	        while not session.closed.is_set():
   167	            msg = await ws.receive()
   168	            if msg["type"] == "websocket.disconnect":
   169	                break
   170	            data = msg.get("bytes")
   171	            if data:
   172	                # Khung quá trần/quá fps: bỏ khung, KHÔNG đóng phiên (Task 9).
   173	                now = time.monotonic()
   174	                if len(data) > config.LIVE_MAX_FRAME_BYTES or now - last < min_gap:
   175	                    continue
   176	                last = now
   177	                frame = protocol.parse_frame(data)
   178	                if frame is not None:
   179	                    box.put(frame)
   180	    except (WebSocketDisconnect, RuntimeError):
   181	        pass
   182	    finally:
   183	        box.closed = True
   184	        box.event.set()
