   238	async def run(ws: WebSocket, session: LiveSession) -> None:
   239	    mode = session.params.get("mode", "read")
   240	    box = _Mailbox()
   241	    receiver = asyncio.create_task(receive_frames(ws, box, session))
   242	    aligner = text_align.Aligner()
   243	    det = text_align.detector()
   244	    started = time.monotonic()
   245	    deadline = started + config.OCR_ALIGN_TIMEOUT_S
   246	    best_vga: bytes | None = None
   247	    debug = getattr(ws, "debug", None)  # chỉ có trên LiveSocket của phiên bật debug (demo)
   248	    try:
   249	        if mode == "money_retry":
   250	            await _money_retry(ws, box, session)
   251	            return
   252	        await ws.send_text(protocol.cam("vga", 5))
   253	        capture_sent = False
   254	        capture_deadline = 0.0
   255	        hi_res: bytes | None = None
   256	        while not box.closed and not session.closed.is_set():
   257	            now = time.monotonic()
   258	            if not capture_sent and now >= deadline:
   259	                logger.info("OCR live: hết trần %.0fs, chụp luôn", config.OCR_ALIGN_TIMEOUT_S)
   260	                capture_sent, capture_deadline = True, now + 3.0
   261	                await ws.send_text(protocol.capture("uxga"))
   262	            if capture_sent and now >= capture_deadline:
   263	                break
   264	            frame = await box.take(0.5)
   265	            if frame is None:
   266	                continue
   267	            if _width(frame) >= 1000:
   268	                hi_res = frame
   269	                break
   270	            if capture_sent:
   271	                continue
   272	            best_vga = frame
   273	            decoded = await asyncio.to_thread(text_align.decode_gray, frame)
   274	            if decoded is None:
   275	                continue
   276	            gray, _ = decoded
   277	            boxes = await asyncio.to_thread(det.detect, gray)
   278	            action = aligner.step_gray(gray, boxes)
   279	            if debug is not None:
   280	                debug({"t": "ocr", "w": gray.shape[1], "h": gray.shape[0],
   281	                       "boxes": [[int(v) for v in b] for b in boxes],
   282	                       "cue": action.cue if action is not None and action.kind == "cue" else None,
   283	                       "capture": action is not None and action.kind == "capture"})
   284	            if action is None:
   285	                continue
   286	            if action.kind == "cue":
   287	                await ws.send_text(protocol.cue(action.cue))
   288	            else:
   289	                logger.info("OCR live: khung đạt sau %.1fs, chụp UXGA", time.monotonic() - started)
   290	                capture_sent, capture_deadline = True, time.monotonic() + 3.0
   291	                await ws.send_text(protocol.capture("uxga"))
   292	
   293	        image = pick_image(hi_res, session.params.get("fallback_jpeg"), best_vga)
   294	        if image is None or box.closed or session.closed.is_set():
   295	            return
   296	        loop = asyncio.get_running_loop()
   297	        await speak_ws(ws, speech.sync_iter(spoken(image, mode, session.device), loop))
   298	        await ws.send_text(protocol.end())
   299	    except (WebSocketDisconnect, RuntimeError) as exc:
   300	        logger.info("OCR live: kính ngắt kết nối (%r), huỷ", exc)
   301	    finally:
   302	        receiver.cancel()
   303	        sessions.release(session)
   130	            ctx.spec_answer.cancel()
   131	            ctx.spec_answer = None
   132	        return Reply(speech=_sync(ctx, _web_answer(d, text)), intent=d.intent, lane="A")
   133	
   134	    spec = ctx.spec_answer
   135	    if spec is not None and spec.key == (d.intent, text):
   136	        ctx.spec_answer = None
   137	        logger.info("làn A: dùng câu trả lời đã sinh song song với Clef")
   138	        return Reply(speech=_sync(ctx, spec.replay()), intent=d.intent, lane="A")
   139	    if spec is not None:
   140	        spec.cancel()
   141	        ctx.spec_answer = None
   142	    return Reply(speech=_sync(ctx, general.answer(d.intent, text, image)), intent=d.intent, lane="A")
