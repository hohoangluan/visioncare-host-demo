   123	def top_labels(choice: dict, text: str) -> list[tuple[str, float]]:
   124	    """[(nhãn đã chọn, xác suất), (nhãn thay thế mạnh nhất, xác suất tiền tố)] từ logprobs của lượt chọn nhãn.
   125	
   126	    Nhãn thay thế = nhánh rẽ có xác suất lớn nhất: tại token thứ i, token khác `top_logprobs` ghép với phần đã chọn
   127	    cho tiền tố của một nhãn khác trong CHOICES; xác suất = tích tới i-1 x xác suất token thay thế (cận dưới, phần đuôi
   128	    nhãn không tính). Không có logprobs -> []; không có nhánh nào hợp lệ -> chỉ top-1.
   129	    """
   130	    items = (choice.get("logprobs") or {}).get("content")
   131	    p1 = prefix_prob(choice, len(text))
   132	    if not items or p1 is None:
   133	        return []
   134	    top, best = [(text, p1)], None
   135	    pos, cum = 0, 0.0
   136	    for it in items:
   137	        if pos >= len(text) or it.get("logprob") is None:
   138	            break
   139	        for alt in it.get("top_logprobs") or []:
   140	            token, lp = alt.get("token", ""), alt.get("logprob")
   141	            if token == it.get("token") or lp is None:
   142	                continue
   143	            label = _label_for_prefix(text[:pos] + token, text)
   144	            if label is not None and (best is None or cum + lp > best[1]):
