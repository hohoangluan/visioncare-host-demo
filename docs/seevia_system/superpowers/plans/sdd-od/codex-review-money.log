   193	async def _money(ctx: TurnContext, jpeg: bytes) -> Reply:
   194	    """Đọc tiền v2: đọc chặt 1 khung (ảnh buffer UXGA, τ MONEY_MIN_PROB). Chắc -> nói mệnh giá, trễ như cũ. Không chắc ->
   195	    nói MỘT câu hướng dẫn (read_money.hint) và, có WS, mở phiên live `money_retry` đọc lại đúng một lần từ khung mới
   196	    (lanes/ocr_live._money_retry). Phiên mang mode "ocr" để nav live được tạm nhường chỗ rồi dựng lại như mọi OCR live.
   197	    "Không có tiền" và lỗi mạng giữ câu cũ, không đọc lại."""
   198	    sentence, top = await ocr_live.read_money_frame(jpeg, config.MONEY_MIN_PROB)
   199	    if sentence != read_money.UNSURE or top is None:
   200	        return Reply(speech=[sentence], intent="money", lane="B")
   201	    line = read_money.hint(top, await asyncio.to_thread(read_money.blur_score, jpeg))
   202	    logger.info("làn B tiền: chưa chắc (top=%s) -> %r%s", top, line, "" if not ctx.single_shot else " (không WS, không đọc lại)")
