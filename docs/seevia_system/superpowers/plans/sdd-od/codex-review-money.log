    28	
    29	class SessionManager:
    30	    def __init__(self) -> None:
    31	        self._lock = threading.Lock()
    32	        self._pending: dict[str, LiveSession] = {}
    33	        self._active: dict[str, LiveSession] = {}  # device -> phiên đang mở
    34	
    35	    def create(self, device: str, mode: str, params: dict | None = None) -> LiveSession:
    36	        session = LiveSession(secrets.token_urlsafe(12), device, mode, dict(params or {}))
    37	        with self._lock:
    38	            self._prune()
    39	            self._pending[session.token] = session
    40	        return session
    41	
    42	    def _prune(self) -> None:
    43	        now = time.monotonic()
    44	        for token in [t for t, s in self._pending.items() if now - s.created_at > config.LIVE_TOKEN_TTL_S]:
    45	            del self._pending[token]
    46	
    47	    def claim(self, token: str) -> LiveSession | None:
    48	        """Dùng token đúng một lần; mở phiên mới thì đóng phiên cũ của kính đó."""
    49	        with self._lock:
    50	            self._prune()
    51	            session = self._pending.pop(token, None)
    52	            if session is None:
    53	                return None
    54	            old = self._active.get(session.device)
    55	            if old is not None:
    56	                old.closed.set()
    57	            self._active[session.device] = session
    58	            return session
    59	
    60	    def discard(self, token: str | None) -> None:
    61	        if token:
    62	            with self._lock:
    63	                self._pending.pop(token, None)
    64	
    65	    def active(self, device: str) -> LiveSession | None:
    66	        with self._lock:
    67	            session = self._active.get(device)
    68	            return None if session is None or session.closed.is_set() else session
    69	
    70	    def release(self, session: LiveSession) -> None:
    71	        session.closed.set()
    72	        with self._lock:
    73	            if self._active.get(session.device) is session:
    74	                del self._active[session.device]
    75	
    76	    def close_device(self, device: str, mode: str | None = None) -> bool:
    77	        """Đóng phiên đang chạy của kính (vd. "tắt cảnh báo"). True nếu có phiên."""
    78	        with self._lock:
    79	            session = self._active.get(device)
    80	            if session is None or (mode is not None and session.mode != mode):
    81	                return False
    82	            session.closed.set()
    83	            del self._active[device]
    84	            return True
    85	
    86	    def clear(self) -> None:
    87	        with self._lock:
    88	            for session in self._active.values():
    89	                session.closed.set()
    90	            self._pending.clear()
    91	            self._active.clear()
    92	
    93	
    94	sessions = SessionManager()
     1	"""Giả `WebSocket` cho `ocr_live.run` / `nav_live.run` chạy trên socket phiên `/v2/session`.
     2	
     3	Hai runner live viết cho `WS /v2/live` riêng và chỉ gọi đúng 3 method trên socket
     4	(đọc từ `lanes/ocr_live.py::receive_frames`, `speak_ws`, `run` và
     5	`lanes/nav_live.py::run`, `_speak_outbox`):
     6	
     7	    await ws.receive()      -> dict kiểu starlette ("websocket.receive" / "websocket.disconnect")
     8	    await ws.send_text(s)
     9	    await ws.send_bytes(b)
    10	
    11	Chỉ cài đúng ba method đó. Vòng nhận của phiên là nơi DUY NHẤT đọc socket thật;
    12	nó đẩy khung live vào đây bằng `feed_frame` (khung 0x04 của kính đổi về 0x01 + JPEG
    13	là định dạng `protocol.parse_frame` mong đợi) và báo ngắt bằng `feed_disconnect`.
    14	"""
    15	
    16	import asyncio
    17	import contextlib
    18	import json
    19	from collections.abc import Awaitable, Callable
    20	
    21	from live import protocol
    22	from pipeline import cues, speech
    23	
    24	_QUEUE_MAX = 8  # runner chỉ giữ khung mới nhất (_Mailbox); đầy thì bỏ khung cũ nhất
    25	
    26	
    27	class LiveSocket:
    28	    def __init__(
    29	        self,
    30	        send_text: Callable[[str], Awaitable[None]],
    31	        send_bytes: Callable[[bytes], Awaitable[None]],
    32	        speak_cues: bool = False,
    33	        audio_lock: asyncio.Lock | None = None,
    34	        debug: Callable[[dict], None] | None = None,
    35	    ) -> None:
    36	        # Khoá kênh audio 0x02 của phiên: mỗi câu nói (outbox nav, OCR, cue đọc thay clip) giữ nó trọn câu
    37	        # để không xen với câu trả lời của lượt / kết quả hành động. Khung JSON không cần khoá.
    38	        self.audio_lock = audio_lock
    39	        # Chỉ phiên bật `hello.debug` (trang demo) mới có: runner gửi khung det/ocr bằng móc này,
    40	        # không chờ và không bao giờ ném lỗi (xem `DeviceSession.emit_debug`).
    41	        self.debug = debug
    42	        # Kính có `cue_version` cũ hơn server (không có clip trong flash): khung
    43	        # {"t":"cue"} đổi thành câu nói TTS, giống `_send_reply` làm với cue của lượt.
    44	        self._speak_cues = speak_cues
    45	        self._send_text = send_text
    46	        self._send_bytes = send_bytes
    47	        self._inbox: asyncio.Queue = asyncio.Queue(_QUEUE_MAX)
    48	        self._closed = False
    49	
    50	    # --- phía vòng nhận của phiên ---
    51	    def feed_frame(self, jpeg: bytes) -> None:
    52	        if self._closed:
    53	            return
    54	        if self._inbox.full():
    55	            self._inbox.get_nowait()
    56	        self._inbox.put_nowait({"type": "websocket.receive", "bytes": bytes([protocol.FRAME_JPEG]) + jpeg})
    57	
    58	    def feed_disconnect(self) -> None:
    59	        if self._closed:
    60	            return
    61	        self._closed = True
    62	        while self._inbox.full():
    63	            self._inbox.get_nowait()
    64	        self._inbox.put_nowait({"type": "websocket.disconnect", "code": 1000})
    65	
    66	    # --- phía runner ---
    67	    async def receive(self) -> dict:
    68	        return await self._inbox.get()
    69	
    70	    async def send_text(self, data: str) -> None:
    71	        if self._speak_cues and '"cue"' in data:
    72	            try:
    73	                frame = json.loads(data)
    74	            except ValueError:
    75	                frame = None
    76	            if isinstance(frame, dict) and frame.get("t") == "cue":
