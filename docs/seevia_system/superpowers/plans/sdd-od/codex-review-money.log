   145	async def _web_answer(d: Decision, text: str) -> AsyncIterator[str]:
   146	    """Câu cần tra web: câu đệm phát NGAY, tra (trần `SEARCH_TIMEOUT_S`) chạy dưới câu đệm.
   147	
   148	    Không khoá hoặc tra hỏng -> `search_failed`: Gemma nói thẳng là chưa tra được.
   149	    """
   150	    if not search.available():
   151	        results = None
   152	    else:
   153	        task = asyncio.ensure_future(search.search(text))
   154	        try:
   155	            if config.SEARCH_FILLER:
   156	                yield FILLER_SEARCHING + "\n"
   157	            results = await task
   158	        finally:
   159	            task.cancel()
   160	    async for piece in general.answer(d.intent, text, None, results, search_failed=results is None):
   161	        yield piece
