     2	
     3	Token tạo ngay lúc ĐOÁN SỚM ra làn B/C (prewarm, §7.4) nên khi `/v2/turn` trả
     4	header thì token đã có sẵn. Đoán sai thì token hết hạn sau 10 s, không ai dùng.
     5	"""
     6	
     7	import queue
     8	import secrets
     9	import threading
    10	import time
    11	from dataclasses import dataclass, field
    12	
    13	import config
    14	
    15	
    16	@dataclass
    17	class LiveSession:
    18	    token: str
    19	    device: str
    20	    mode: str  # "ocr" | "nav"
    21	    params: dict = field(default_factory=dict)
    22	    created_at: float = field(default_factory=time.monotonic)
    23	    # Gắn khi WS mở; `close()` từ chỗ khác (nav_stop, lượt mới) đặt cờ này.
    24	    closed: threading.Event = field(default_factory=threading.Event)
    25	    # Hàng đợi audio đẩy vào phiên từ ngoài (vd. kết quả làn D khi đang dẫn đường).
    26	    outbox: queue.Queue = field(default_factory=queue.Queue)
