   187	async def speak_ws(ws: WebSocket, text) -> None:
   188	    """Text (iterable đồng bộ) -> TTS -> khung 0x02 ADPCM qua WS.
   189	
   190	    Trên `/v2/session` giữ khoá audio của phiên (`ws.audio_lock`) trọn câu: kết quả hành động / câu trả lời
   191	    lượt khác xếp hàng sau, không xen vào audio đọc chữ.
   192	    """
   193	    async with getattr(ws, "audio_lock", None) or contextlib.nullcontext():
   194	        async with contextlib.aclosing(speech.adpcm_stream(text)) as chunks:
   195	            async for chunk in chunks:
   196	                await ws.send_bytes(protocol.audio(chunk))
