   199	async def _money_retry(ws: WebSocket, box: _Mailbox, session: LiveSession) -> None:
   200	    """Đọc tiền lại MỘT lần sau câu hướng dẫn (final_router._money): bỏ khung trong MONEY_RETRY_SETTLE_S đầu cho người
   201	    dùng chỉnh tay, lấy khung đầu tiên đủ nét (độ nét >= MONEY_BLUR_HINT); hết MONEY_RETRY_TIMEOUT_S thì khung nét nhất
   202	    đã thấy; không có khung nào thì nói "vẫn chưa đọc chắc". Không bao giờ đọc lần thứ hai (người khiếm thị không kẹt vòng lặp)."""
   203	    started = time.monotonic()
   204	    settle_end, deadline = started + config.MONEY_RETRY_SETTLE_S, started + config.MONEY_RETRY_TIMEOUT_S
   205	    await ws.send_text(protocol.cam("vga", 5))
   206	    best, best_score = None, -1.0
   207	    while not box.closed and not session.closed.is_set():
   208	        left = deadline - time.monotonic()
   209	        if left <= 0:
   210	            break
   211	        frame = await box.take(min(0.5, left))
   212	        if frame is None or time.monotonic() < settle_end:
   213	            continue  # chưa có khung, hoặc khung chụp lúc người dùng còn đang chỉnh tay
   214	        score = await asyncio.to_thread(read_money.blur_score, frame)
   215	        if score is None:
   216	            continue
   217	        if score > best_score:
   218	            best, best_score = frame, score
   219	        if score >= config.MONEY_BLUR_HINT:
   220	            break
   221	    if box.closed or session.closed.is_set():
   222	        return
   223	    sentence = read_money.RETRY_FAILED
   224	    if best is not None:
   225	        logger.info("đọc tiền đọc lại: dùng khung nét %.0f (ngưỡng %.0f) sau %.1fs", best_score,
   226	                    config.MONEY_BLUR_HINT, time.monotonic() - started)
   227	        said, _ = await read_money_frame(best, config.MONEY_RETRY_PROB)
   228	        if said in read_money.LABELS:
   229	            sentence = said
   230	    else:
   231	        logger.info("đọc tiền đọc lại: không có khung nào trong %.1fs", config.MONEY_RETRY_TIMEOUT_S)
   232	    if box.closed or session.closed.is_set():
   233	        return
   234	    await speak_ws(ws, [sentence])
   235	    await ws.send_text(protocol.end())
   236	
