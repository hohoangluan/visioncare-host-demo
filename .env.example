# Sao chép thành `.env` rồi điền giá trị thật. `.env` đã nằm trong .gitignore.
# Biến nào bỏ trống hoặc xoá đi thì dùng mặc định trong config.py.
# Chi tiết LLM/Clef/TLS: docs/LLM_PROVIDER.md

# --- Gemini (chat, intent, tìm kiếm) -----------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SEARCH_MODEL=gemini-2.5-flash-lite
GEMINI_INTENT_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_BUDGET=-1

# --- Agent: LLM provider (Gemma trên UIT) ------------------------------------
AGENT_API_KEY=
AGENT_BASE_URL=https://llm.uit.edu.vn/gemma/v1
AGENT_MODEL=gemma-4-26b

# --- Intent: Cloudflare Clef -------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLEF_MODEL=clef-flash
CLEF_MODEL_ID=@cf/cloudflare/clef-flash
CLEF_TIMEOUT_S=1

# --- ASR: ChunkFormer chạy local trên GPU ------------------------------------
ASR_MODEL=khanhld/chunkformer-ctc-large-vie

# --- VisionCare host (server giao tiếp với app điện thoại) -------------------
VISIONCARE_HOST_URL=http://127.0.0.1:8001
VISIONCARE_CLIENT_TOKEN=
VISIONCARE_DEVICE_ID=glasses-123
# Token của kính, chỉ dùng cho start-demo.ps1 và tools/manual/live_server_calls.py.
VISIONCARE_DEVICE_CLIENT_TOKEN=
# Token server tự kiểm khi nhận callback /internal/action-results.
VISIONCARE_CALLBACK_TOKEN=
VISIONCARE_RESULT_TIMEOUT_SECONDS=25
VISIONCARE_RESULT_POLL_SECONDS=0.5
VISIONCARE_FAST_ACTION_SECONDS=2.0

# --- Audio trả về board ------------------------------------------------------
# auto | mp3_stream | pcm_stream | wav
RESPONSE_FORMAT=auto
AUDIO_PREROLL_SECONDS=2.0
# warm_melodic | chime | voice
AUDIO_PREROLL_MODE=warm_melodic
SPEECH_SENTENCE_PAUSE_SECONDS=0.45
TTS_VOICE=Ngọc Linh
TTS_STYLE=tu_nhien
TTS_PRERENDER=1

# --- STT ------------------------------------------------------
STT_MODEL_DIR=./models/stt
STT_NUM_THREADS=2

# --- Chat ---------------------------------------------------------------------
CHAT_HISTORY_TURNS=6
CHAT_HISTORY_TTL_SECONDS=600
CHAT_ALWAYS_SEARCH=1

# --- Đường dẫn / cache --------------------------------------------------------
STORAGE_DIR=./storage
# MODEL_CACHE_DIR=./models/.cache

# --- Chứng chỉ TLS cho llm.uit.edu.vn (xem docs/LLM_PROVIDER.md) -------------
# SSL_CERT_FILE=certs/uit-ca-bundle.pem
# CURL_CA_BUNDLE=certs/uit-ca-bundle.pem

# --- Chỉ dùng cho start-demo.ps1 / tools/manual (Windows) --------------------
# VISIONCARE_BACKEND_ROOT=../app-demo-backend
# ADB_PATH=adb
# FFMPEG_PATH=
# VISIONCARE_PROCESS_URL=http://127.0.0.1:8000/process

# Voice server v2: tra web (SerpAPI) + câu đệm
SERPAPI_API_KEY=
SEARCH_FILLER=1
SEARCH_TIMEOUT_S=2.5
# Định dạng đầu ra Gemma phân loại intent: choice (mặc định, nhanh) hoặc json (bản cũ)
# INTENT_FORMAT=choice

# --- VAD (Task 2b) ---
# VAD_ENABLED=
# VAD_MODEL_PATH=
# VAD_END_SILENCE_S=
# VAD_THRESHOLD=
# VAD_PAD_S=
# VAD_EARLY_FINAL=
# V2_DEBUG_STATS=
